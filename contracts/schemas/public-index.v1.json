{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LabHippo fictional public-index contract v1",
  "description": "Demo only. Structural schema; byte limits, Markdown parsing, project policy, revisions and transaction checks are authoritative in demo-service.js.",
  "type": "object",
  "required": [
    "contract_version",
    "demo_only",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 1
    },
    "demo_only": {
      "const": true
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "summary",
          "tags",
          "project_id",
          "related_ids",
          "revision",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^lh:[a-z]+/[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "kind": {
            "enum": [
              "project",
              "project-event",
              "resource",
              "log"
            ]
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "project_id": {
            "enum": [
              "lh:proj/demo-contract-alpha",
              "lh:proj/demo-contract-beta"
            ]
          },
          "related_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^lh:[a-z]+/[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
